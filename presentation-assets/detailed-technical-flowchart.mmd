%% LouNgak AI (AG-04) — detailed technical flow, for appendix / technical Q&A
%% Built from commit 7924fba on feature/ag04-integration. Branch-by-branch, not a summary.
%% Render: see detailed-technical-flowchart.png, or `npx -y @mermaid-js/mermaid-cli -i this -o out.svg`

flowchart TD
  classDef input  fill:#F1F8F4,stroke:#1B7F4F,stroke-width:1.5px,color:#1F2937
  classDef route  fill:#EFF9F7,stroke:#0F766E,stroke-width:1.5px,color:#1F2937
  classDef data   fill:#EFF6FC,stroke:#1E6FA8,stroke-width:1.5px,color:#1F2937
  classDef risk   fill:#FDF6EC,stroke:#B45309,stroke-width:1.5px,color:#1F2937
  classDef result fill:#F4F6F8,stroke:#334155,stroke-width:1.5px,color:#1F2937
  classDef fail   fill:#FEF2F2,stroke:#B91C1C,stroke-width:1.5px,color:#7F1D1D
  classDef gate   fill:#FFFFFF,stroke:#64748B,stroke-width:1.5px,color:#1F2937

  %% ================= INPUT =================
  IN1["Typed question<br/>English or Manipuri"]:::input
  IN2["Map: select zone /<br/>draw area / 'here'"]:::input

  %% ================= LANGUAGE + ROUTING (satquery/agri/query.py, agent/language.py) =================
  subgraph ROUTE["Query routing — rule-based, deterministic"]
    direction TB
    R1{"English cue regex:<br/>INSPECT / RANK / EXPLAIN /<br/>AGRI_CONTEXT+HERE?"}:::gate
    R2{"Latin/Meitei Mayek?<br/>(satquery.agent.language.normalize)"}:::gate
    R3["Concept match → common intent<br/>AREA_RISK_QUERY · INSPECTION_PRIORITY ·<br/>AREA_EXPLANATION · AREA_SPECIFIC_RISK ·<br/>PEST_RISK · CROP_HEALTH · WEATHER_RISK"]:::route
    R4{"RISK_CONCEPTS present?<br/>(risk / pest / inspect)"}:::gate
    R5{"Imagery cue or<br/>named target (water, crop...)?"}:::gate
    R6["agri: rank / inspect / explain"]:::route
    R7["weather specialist"]:::route
    R8["imagery / NDVI specialist"]:::route
    R9["REPHRASE — asked to clarify,<br/>never guessed or sent to imagery"]:::fail
    R10["mixed: weather + imagery<br/>in one question → asked to split"]:::fail

    R1 -- yes --> R6
    R1 -- no --> R2
    R2 -- Manipuri --> R3 --> R6
    R2 -- English, no cue --> R4
    R4 -- no --> R5
    R5 -- yes --> R8
    R5 -- no --> R9
    R4 -- yes, but no area/intent --> R9
  end
  IN1 --> R1
  IN2 -. "selected area" context .-> R6

  %% ================= AREA RESOLUTION =================
  subgraph AREA["Area resolution (query.py resolve_area / aliases)"]
    direction TB
    AR1{"Area named in text?"}:::gate
    AR2{"'here' / selected zone<br/>on map?"}:::gate
    AR3["Resolved to one MonitoredArea"]:::route
    AR4["Ambiguous — ask which one"]:::fail
    AR5["No match — list monitored areas"]:::fail
    AR1 -- one match --> AR3
    AR1 -- several --> AR4
    AR1 -- none --> AR2
    AR2 -- yes --> AR3
    AR2 -- no --> AR5
  end
  R6 --> AR1

  %% ================= EVIDENCE GATHERING (pipeline.py assess_area) =================
  subgraph EVID["Evidence — each source independent; one failing never blocks the others"]
    direction TB

    subgraph W["Weather — Open-Meteo"]
      direction TB
      W1["fetch(lat, lon)<br/>14 d history + 7 d forecast, hourly"]:::data
      W2{"reachable?"}:::gate
      W3["pest_rules.evaluate() per rule<br/>vs hourly temp / RH thresholds"]:::data
      W4["unavailable:<br/>'no weather source configured'<br/>or provider error"]:::fail
      W1 --> W2
      W2 -- yes --> W3
      W2 -- no --> W4
    end

    subgraph N["NDVI — Sentinel-2 (Copernicus)"]
      direction TB
      N1{"Copernicus credentials<br/>configured?"}:::gate
      N2["current window (30 d) +<br/>up to 3 prior-year baseline windows"]:::data
      N3{"current usable &<br/>≥ min baseline years?"}:::gate
      N4["relative_change vs<br/>baseline_mean"]:::data
      N5["unavailable:<br/>no credentials / cloud or no data /<br/>baseline incomplete"]:::fail
      N1 -- yes --> N2 --> N3
      N1 -- no --> N5
      N3 -- yes --> N4
      N3 -- no --> N5
    end

    subgraph P["Pest reports — SAMPLE generator"]
      direction TB
      P1["seeded synthetic reports,<br/>14-day look-back, by severity"]:::data
      P2["source: SAMPLE, synthetic: true<br/>— never shown as real"]:::data
      P1 --> P2
    end
  end
  AR3 --> EVID

  %% ================= SCORING (risk.py) =================
  subgraph SCORE["Scoring — risk.combine()"]
    direction TB
    S1["weather_factor<br/>weight 0.5"]:::risk
    S2["ndvi_factor<br/>weight 0.3"]:::risk
    S3["report_factor<br/>weight 0.2"]:::risk
    S4["completeness =<br/>Σ(weight × availability) / Σ(weight)"]:::risk
    S5["score =<br/>Σ(weight × factor score) / Σ(weight of available factors)<br/>— unavailable factors excluded, never estimated"]:::risk
    S6{"completeness ≥ 50%<br/>AND score not null?"}:::gate
    S7["INSUFFICIENT_DATA<br/>no level given"]:::fail
    S8{"score ≥ 0.80?"}:::gate
    S9{"≥2 factors ≥0.60 AND<br/>completeness ≥90%?"}:::gate
    S10["CRITICAL"]:::risk
    S11["HIGH<br/>(critical band, corroboration<br/>requirement not met)"]:::risk
    S12{"score ≥ 0.60?"}:::gate
    S13["HIGH"]:::risk
    S14{"score ≥ 0.35?"}:::gate
    S15["MODERATE"]:::risk
    S16["LOW"]:::risk
    S17["confidence: high/medium/low<br/>from completeness;<br/>capped at medium if SAMPLE used;<br/>low if thresholds PLACEHOLDER"]:::risk

    W3 --> S1
    W4 --> S1
    N4 --> S2
    N5 --> S2
    P2 --> S3
    S1 & S2 & S3 --> S4 --> S5 --> S6
    S6 -- no --> S7
    S6 -- yes --> S8
    S8 -- yes --> S9
    S9 -- yes --> S10
    S9 -- no --> S11
    S8 -- no --> S12
    S12 -- yes --> S13
    S12 -- no --> S14
    S14 -- yes --> S15
    S14 -- no --> S16
    S10 & S11 & S13 & S15 & S16 & S7 --> S17
  end

  %% ================= RANKING & OUTPUT =================
  subgraph OUT["Rank & present (routes.py, risk.rank, web/src/agri)"]
    direction TB
    O1["rank() — most urgent first<br/>across all monitored zones"]:::result
    O2["Districts: grouped by zone,<br/>never scored themselves"]:::result
    O3["Map: zones coloured by level;<br/>district outlines as context"]:::result
    O4["Score breakdown, reasons,<br/>provenance per factor"]:::result
    O5{"Latin Manipuri<br/>question?"}:::gate
    O6["Answer via templates<br/>(answer_language.py) —<br/>same figures, translated framing"]:::result
    O7["Answer in English"]:::result

    S17 --> O1 --> O2 --> O3 --> O4 --> O5
    O5 -- yes --> O6
    O5 -- no --> O7
  end

  W7["/api/weather response"]:::result
  N7["NDVI crop-health card<br/>(cloud-masked, SCL-filtered)"]:::result
  R7 --> W1
  R8 --> N1
  W2 -. "also answers" .-> W7
  N3 -. "also answers" .-> N7
